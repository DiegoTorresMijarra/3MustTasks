<Project Sdk="Microsoft.NET.Sdk.Razor">

    <!-- Solo Android en v1 (spec §1 y §5.1). Requiere el workload maui-android; por eso no está en ThreeMustTasks.sln
         y se compila en su propio job de CI. -->
    <PropertyGroup>
        <TargetFramework>net10.0-android</TargetFramework>

        <OutputType>Exe</OutputType>
        <RootNamespace>ThreeMustTasks.App.Maui</RootNamespace>
        <UseMaui>true</UseMaui>
        <SingleProject>true</SingleProject>
        <EnableDefaultCssItems>false</EnableDefaultCssItems>

        <ApplicationTitle>3MustTasks</ApplicationTitle>
        <ApplicationId>com.threemusttasks.app</ApplicationId>
        <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
        <ApplicationVersion>1</ApplicationVersion>

        <!-- minSdk 26 (spec §5.1) -->
        <SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion>
    </PropertyGroup>

    <ItemGroup>
        <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#3f51b5" />
        <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#3f51b5" BaseSize="128,128" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="$(MauiVersion)" />
        <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\ThreeMustTasks.UI\ThreeMustTasks.UI.csproj" />
        <ProjectReference Include="..\ThreeMustTasks.Core\ThreeMustTasks.Core.csproj" />
        <ProjectReference Include="..\ThreeMustTasks.Infrastructure.Sqlite\ThreeMustTasks.Infrastructure.Sqlite.csproj" />
    </ItemGroup>

</Project>
