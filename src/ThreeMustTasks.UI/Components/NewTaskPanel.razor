@using ThreeMustTasks.Core.Services
@implements IDisposable
@inject TodayService Today
@inject FavoriteService Favorites
@inject RecurrenceService Recurrences
@inject IStringLocalizer<Strings> L
@inject PlanEvents Events

@* Alta de tarea nueva (formulario rápido). Lo usan la página /tarea/nueva y la pestaña Nueva de Planificar. *@
@if (_view is not null)
{
    <TaskForm @key="_formKey" Title="Title" Groups="_view.Groups" InitialLevelId="InitialLevelId" FullLevelId="_fullLevelId" TodayDate="_view.Date" Error="@_error"
              OnSave="SaveAsync" OnSendToPool="SaveToPoolAsync" OnCancel="() => OnDone.InvokeAsync()" />
}

@code {
    private TodayView? _view;
    private Guid? _fullLevelId;
    private string? _error;
    private Guid _formKey = Guid.NewGuid();

    [Parameter] public Guid? InitialLevelId { get; set; }

    /// <summary>Título con cabecera Cancelar · título · Guardar (página /tarea/nueva); null en la pestaña de Planificar.</summary>
    [Parameter] public string? Title { get; set; }

    /// <summary>Tarea guardada (o cancelado): el host decide si vuelve a Hoy o deja el formulario en blanco.</summary>
    [Parameter] public EventCallback OnDone { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Events.PlanChanged += OnPlanChanged;
        _view = await Today.GetAsync();
    }

    private void OnPlanChanged(DateOnly _) => InvokeAsync(async () =>
    {
        _view = await Today.GetAsync();
        StateHasChanged();
    });

    private async Task SaveAsync(NewTaskRequest request)
    {
        if (!ValidRecurrence(request)) return;
        var result = await Today.AddAsync(request);
        if (result.Outcome == AddTaskOutcome.LevelFull) { _fullLevelId = request.LevelId; return; }
        await FinishAsync(request, result);
    }

    private async Task SaveToPoolAsync(NewTaskRequest request)
    {
        if (!ValidRecurrence(request)) return;
        await FinishAsync(request, await Today.AddAsync(request));
    }

    private bool ValidRecurrence(NewTaskRequest request)
    {
        _error = null;
        if (request.Recurrence?.Validate(_view!.Date) is not { } invalid) return true;
        _error = RecurrenceText.Error(L, invalid);
        return false;
    }

    private async Task FinishAsync(NewTaskRequest request, AddTaskResult result)
    {
        if (!result.Succeeded) return;
        if (request.MarkFavorite && result.Task is not null) await Favorites.MarkAsync(result.Task.Id);
        // La tarea recién creada pasa a ser la primera instancia de la regla elegida (si hay).
        if (request.Recurrence is { } spec && result.Task is not null) await Recurrences.CreateFromTaskAsync(result.Task.Id, spec);
        _fullLevelId = null;
        _formKey = Guid.NewGuid();
        _view = await Today.GetAsync();
        await OnDone.InvokeAsync();
    }

    public void Dispose() => Events.PlanChanged -= OnPlanChanged;
}
