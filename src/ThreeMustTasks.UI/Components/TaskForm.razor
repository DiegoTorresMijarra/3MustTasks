@using ThreeMustTasks.Core.Services
@inject IStringLocalizer<Strings> L
@inject ThreeMustTasks.Core.Ports.ISettingsStore SettingsStore

@* Formulario de tarea. Nueva: título y nivel. Edición (Existing != null): además categoría, cuándo, hora, recordatorio y notas. *@
<form class="tmt-form @(HasHeader ? "tmt-form-page" : "")" @onsubmit="SubmitAsync" @onsubmit:preventDefault data-testid="task-form">
    @if (HasHeader)
    {
        @* Cabecera del mock NuevaTarea: Cancelar · título · Guardar. *@
        <header class="tmt-form-head">
            <button type="button" class="tmt-head-btn" data-testid="cancel" @onclick="() => OnCancel.InvokeAsync()">@L["Form_Cancel"]</button>
            <h1 class="tmt-title">@Title</h1>
            <button type="submit" class="tmt-head-btn strong" disabled="@string.IsNullOrWhiteSpace(_title)" data-testid="save">@L["Form_Save"]</button>
        </header>
    }
    @if (!string.IsNullOrEmpty(Error))
    {
        <MudAlert Severity="Severity.Error" Class="mb-3" data-testid="form-error">@Error</MudAlert>
    }

    <MudTextField T="string" @bind-Value="_title" Immediate="true" Label="@L["Form_Title"]" Variant="Variant.Text" Class="tmt-title-field"
                  data-testid="title-input" AutoFocus="true" MaxLength="120" />

    <div class="tmt-form-label">@L["Form_Level"]</div>
    <div class="tmt-level-picker" role="radiogroup" aria-label="@L["Form_Level"]">
        @foreach (var g in Groups)
        {
            var selected = g.Level.Id == _levelId;
            <button type="button" role="radio" aria-checked="@(selected ? "true" : "false")"
                    class="tmt-level-option @(selected ? "selected" : "")" style="--level-color:@g.Level.Color"
                    data-testid="level-@g.Level.Name" @onclick="() => _levelId = g.Level.Id">
                <MudIcon Icon="@LevelIcons.Resolve(g.Level.Icon)" Style="@($"color:{g.Level.Color}")" />
                <span class="tmt-level-name">@g.Level.Name</span>
                <span class="tmt-level-hint">@(g.IsFull ? L["Form_LevelFull"].Value : L["Form_LevelToday", g.Tasks.Count].Value)</span>
            </button>
        }
    </div>

    @if (IsEdit)
    {
        <div class="tmt-form-label">@L["Form_Category"]</div>
        <div class="tmt-chip-row" role="radiogroup" aria-label="@L["Form_Category"]">
            <button type="button" role="radio" aria-checked="@(_categoryId is null ? "true" : "false")"
                    class="tmt-chip @(_categoryId is null ? "selected" : "")" data-testid="category-none"
                    @onclick="() => _categoryId = null">@L["Form_NoCategory"]</button>
            @foreach (var c in Categories)
            {
                var sel = c.Id == _categoryId;
                <button type="button" role="radio" aria-checked="@(sel ? "true" : "false")"
                        class="tmt-chip @(sel ? "selected" : "")" style="--chip-color:@c.Color"
                        data-testid="category-@c.Name" @onclick="() => _categoryId = c.Id">
                    <span class="tmt-dot" aria-hidden="true"></span>@c.Name
                </button>
            }
            <a class="tmt-chip tmt-chip-link" href="ajustes/categorias" data-testid="manage-categories">@L["Form_ManageCategories"]</a>
        </div>

        <div class="tmt-form-label">@L["Form_When"]</div>
        <div class="tmt-segment tmt-segment-lg" role="radiogroup" aria-label="@L["Form_When"]">
            <button type="button" role="radio" aria-checked="@(_when == TaskWhen.Today ? "true" : "false")"
                    class="tmt-seg" data-testid="when-today"
                    @onclick="() => _when = TaskWhen.Today">@L["Form_WhenToday"]</button>
            <button type="button" role="radio" aria-checked="@(_when == TaskWhen.OtherDay ? "true" : "false")"
                    class="tmt-seg" data-testid="when-other"
                    @onclick="() => _when = TaskWhen.OtherDay">@L["Form_WhenOther"]</button>
            <button type="button" role="radio" aria-checked="@(_when == TaskWhen.Pool ? "true" : "false")"
                    class="tmt-seg" data-testid="when-pool"
                    @onclick="() => _when = TaskWhen.Pool">@L["Form_WhenPool"]</button>
        </div>
        @if (_when == TaskWhen.OtherDay)
        {
            <label class="tmt-field">
                <span>@L["Form_Date"]</span>
                <input type="date" @bind="_date" min="@TodayDate.AddDays(1).ToString("yyyy-MM-dd")" data-testid="date-input" />
            </label>
        }

    }

    @* Tarjeta de filas del mock: Fijar, Hora y recordatorio, Repetir, Notas y Favorita (las tres del medio se despliegan). *@
    <div class="tmt-card tmt-rows">
        <label class="tmt-pin-option">
            <svg class="tmt-row-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 3h6l-1 6 4 4H6l4-4z"/><path d="M12 13v8"/></svg>
            <input type="checkbox" @bind="_pinned" data-testid="pin-input" />
            <span>@L["Form_Pin"]</span>
        </label>

        @if (IsEdit)
        {
            <details class="tmt-row-detail" data-testid="row-time">
                <summary>
                    <svg class="tmt-row-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
                    <span class="tmt-row-label">@L["Form_TimeReminder"]</span>
                    <span class="tmt-row-value">@(_time is { } tm ? tm.ToString("HH:mm") : L["Form_NoTime"].Value)</span>
                </summary>
                <div class="tmt-field-row">
                    <label class="tmt-field">
                        <span>@L["Form_Time"]</span>
                        <input type="time" @bind="_time" @bind:format="HH:mm" @bind:after="OnTimeChanged" data-testid="time-input" />
                    </label>
                    <label class="tmt-field">
                        <span>@L["Form_Reminder"]</span>
                        <select @bind="_reminderMinutes" disabled="@(_time is null)" data-testid="reminder-select">
                            <option value="">@L["Form_ReminderNone"]</option>
                            @foreach (var m in ReminderOptions)
                            {
                                <option value="@m">@(m == 0 ? L["Form_ReminderAtTime"].Value : L["Form_ReminderBefore", m].Value)</option>
                            }
                        </select>
                    </label>
                </div>
            </details>
        }

        <details class="tmt-row-detail" data-testid="row-repeat">
            <summary>
                <svg class="tmt-row-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 2l3 3-3 3"/><path d="M4 11V9a4 4 0 0 1 4-4h12"/><path d="M7 22l-3-3 3-3"/><path d="M20 13v2a4 4 0 0 1-4 4H4"/></svg>
                <span class="tmt-row-label">@L["Rec_Section"]</span>
                <span class="tmt-row-value">@(_recurrence is null ? L["Rec_None"].Value : RecurrenceText.Describe(L, _recurrence))</span>
            </summary>
            @if (IsInstance)
            {
                <div class="tmt-level-hint" data-testid="recurrence-instance-hint">@L["Rec_InstanceHint"]</div>
            }
            <RecurrenceEditor Value="_recurrence" ValueChanged="spec => _recurrence = spec" AllowNone="@(!IsInstance)" Anchor="TodayDate" />
        </details>

        @if (IsEdit)
        {
            <details class="tmt-row-detail" data-testid="row-notes">
                <summary>
                    <svg class="tmt-row-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 4h14v16H5z"/><path d="M9 9h6M9 13h6M9 17h3"/></svg>
                    <span class="tmt-row-label">@L["Form_Notes"]</span>
                    <span class="tmt-row-value">@(string.IsNullOrWhiteSpace(_notes) ? "" : _notes)</span>
                </summary>
                <textarea class="tmt-notes" aria-label="@L["Form_Notes"]" rows="3" maxlength="1000" @bind="_notes" @bind:event="oninput" data-testid="notes-input"></textarea>
            </details>
        }

        <label class="tmt-pin-option">
            <svg class="tmt-row-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8-5.2-2.8-5.2 2.8 1-5.8-4.3-4.1 5.9-.9z"/></svg>
            <input type="checkbox" @bind="_favorite" disabled="@(Existing?.Task.IsFavoriteSource == true)" data-testid="favorite-input" />
            <span>@L["Form_Favorite"]</span>
        </label>
    </div>

    @if (FullLevelId is { } fullId && fullId == _levelId)
    {
        <MudAlert Severity="Severity.Warning" Class="mt-3" data-testid="full-alert">
            @L["Form_FullMessage", SelectedName]
            <div class="mt-2">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SendToPoolAsync" data-testid="send-to-pool">@L["Form_SendToPool"]</MudButton>
            </div>
        </MudAlert>
    }

    @if (_pendingEdit is not null)
    {
        <MudAlert Severity="Severity.Info" Class="mt-3" data-testid="scope-prompt">
            @L["Rec_ScopeQuestion"]
            <div class="mt-2 tmt-confirm-actions">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="() => ConfirmScopeAsync(RecurrenceScope.OnlyThis)" data-testid="scope-only">@L["Rec_ScopeOnly"]</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="() => ConfirmScopeAsync(RecurrenceScope.ThisAndFollowing)" data-testid="scope-following">@L["Rec_ScopeFollowing"]</MudButton>
                <MudButton Variant="Variant.Text" OnClick="() => _pendingEdit = null" data-testid="scope-cancel">@L["Form_Cancel"]</MudButton>
            </div>
        </MudAlert>
    }

    @if (_confirmDelete)
    {
        <MudAlert Severity="Severity.Error" Class="mt-3" data-testid="delete-confirm">
            @L["Form_DeleteConfirm"]
            <div class="mt-2 tmt-confirm-actions">
                <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="() => OnDelete.InvokeAsync()" data-testid="delete-yes">@L["Form_DeleteYes"]</MudButton>
                <MudButton Variant="Variant.Text" OnClick="() => _confirmDelete = false" data-testid="delete-no">@L["Form_Cancel"]</MudButton>
            </div>
        </MudAlert>
    }

    @if (HasHeader)
    {
        @if (IsEdit && OnDelete.HasDelegate)
        {
            <div class="tmt-form-actions tmt-form-actions-page">
                <button type="button" class="tmt-danger-btn" @onclick="() => _confirmDelete = true" data-testid="delete">@L["Form_Delete"]</button>
            </div>
        }
    }
    else
    {
        <div class="tmt-form-actions">
            <MudButton Variant="Variant.Text" OnClick="() => OnCancel.InvokeAsync()" data-testid="cancel">@L["Form_Cancel"]</MudButton>
            @if (IsEdit && OnDelete.HasDelegate)
            {
                <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="() => _confirmDelete = true" data-testid="delete">@L["Form_Delete"]</MudButton>
            }
            <MudButton Variant="Variant.Filled" Color="Color.Primary" ButtonType="ButtonType.Submit"
                       Disabled="@string.IsNullOrWhiteSpace(_title)" data-testid="save">@L["Form_Save"]</MudButton>
        </div>
    }
</form>

@code {
    private static readonly int[] ReminderOptions = [0, 5, 15, 30, 60];

    private string? _title;
    private Guid? _selectedLevel;
    private Guid? _categoryId;
    private TaskWhen _when = TaskWhen.Today;
    private DateOnly? _date;
    private TimeOnly? _time;
    private int? _reminderMinutes;
    private string? _notes;
    private bool _pinned;
    private bool _favorite;
    private bool _confirmDelete;
    private bool _loadedExisting;
    private RecurrenceSpec? _recurrence;
    private EditTaskRequest? _pendingEdit;

    /// <summary>Niveles activos con su ocupación de hoy.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<LevelGroup> Groups { get; set; } = [];

    /// <summary>Nivel preseleccionado; si no, el primero.</summary>
    [Parameter] public Guid? InitialLevelId { get; set; }

    /// <summary>Nivel que el host ha rechazado por estar lleno: se ofrece mandar la tarea al pool.</summary>
    [Parameter] public Guid? FullLevelId { get; set; }

    /// <summary>Mensaje de validación devuelto por el host.</summary>
    [Parameter] public string? Error { get; set; }

    /// <summary>Si no es null el formulario está en modo edición con todos los campos.</summary>
    [Parameter] public EditableTask? Existing { get; set; }

    [Parameter] public IReadOnlyList<Category> Categories { get; set; } = [];

    /// <summary>Día lógico actual (para el mínimo del selector de fecha).</summary>
    [Parameter] public DateOnly TodayDate { get; set; }

    [Parameter] public EventCallback<NewTaskRequest> OnSave { get; set; }
    [Parameter] public EventCallback<EditTaskRequest> OnSaveEdit { get; set; }

    /// <summary>Regla de la que viene la tarea que se edita (si es una instancia de una recurrente).</summary>
    [Parameter] public RecurrenceRule? Rule { get; set; }

    /// <summary>Guardado de la edición con su repetición y alcance; si no hay manejador se usa <see cref="OnSaveEdit"/>.</summary>
    [Parameter] public EventCallback<RecurringEdit> OnSaveRecurring { get; set; }
    [Parameter] public EventCallback<NewTaskRequest> OnSendToPool { get; set; }
    [Parameter] public EventCallback OnDelete { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    /// <summary>Título de la pantalla: si se da, el formulario lleva la cabecera Cancelar · título · Guardar del mock.</summary>
    [Parameter] public string? Title { get; set; }

    private bool HasHeader => Title is not null;

    private bool IsEdit => Existing is not null;

    /// <summary>La tarea editada es una instancia de una regla: al guardar se pregunta el alcance.</summary>
    private bool IsInstance => Rule is not null && Existing?.Task.RecurrenceRuleId == Rule.Id;

    private Guid _levelId
    {
        get => _selectedLevel ?? InitialLevelId ?? Groups.FirstOrDefault()?.Level.Id ?? Guid.Empty;
        set => _selectedLevel = value;
    }

    private string SelectedName => Groups.FirstOrDefault(g => g.Level.Id == _levelId)?.Level.Name ?? "";

    protected override void OnParametersSet()
    {
        if (Existing is null || _loadedExisting) return;
        _loadedExisting = true;
        var t = Existing.Task;
        _title = t.Title;
        _selectedLevel = t.LevelId;
        _categoryId = t.CategoryId;
        _when = Existing.When;
        _date = t.ScheduledDate is { } d && d > TodayDate ? d : null;
        _time = t.DueTime;
        _hadTime = _time is not null;
        _reminderMinutes = t.ReminderOffset is { } r ? (int)r.TotalMinutes : null;
        _notes = t.Notes;
        _pinned = t.IsPinned;
        _favorite = t.IsFavoriteSource;
        if (Rule is not null && t.RecurrenceRuleId == Rule.Id) _recurrence = RecurrenceSpec.FromRule(Rule);
    }

    // Al poner hora a una tarea sin recordatorio, se preselecciona la antelación por defecto de Ajustes (issue 20).
    private void OnTimeChanged()
    {
        // Solo al pasar de "sin hora" a "con hora": si el usuario eligió "Sin recordatorio" no se le pisa al retocar la hora.
        if (_time is not null && !_hadTime && _reminderMinutes is null) _reminderMinutes = SettingsStore.Load().DefaultReminderOffsetMin;
        _hadTime = _time is not null;
    }

    private bool _hadTime;

    private Task SubmitAsync()
    {
        if (string.IsNullOrWhiteSpace(_title)) return Task.CompletedTask;
        return IsEdit ? SaveEditAsync(_when) : OnSave.InvokeAsync(new NewTaskRequest(_title, _levelId, IsPinned: _pinned, MarkFavorite: _favorite, Recurrence: _recurrence));
    }

    private Task SendToPoolAsync() =>
        IsEdit ? SaveEditAsync(TaskWhen.Pool)
               : OnSendToPool.InvokeAsync(new NewTaskRequest(_title ?? "", _levelId, AddDestination.Pool, _pinned, MarkFavorite: _favorite, Recurrence: _recurrence));

    private Task SaveEditAsync(TaskWhen when)
    {
        var request = BuildEdit(when);
        if (IsInstance)
        {
            // PRD §6.2: editar una recurrente pregunta si afecta solo a esta instancia o también a las siguientes.
            _pendingEdit = request;
            return Task.CompletedTask;
        }
        return OnSaveRecurring.HasDelegate
            ? OnSaveRecurring.InvokeAsync(new RecurringEdit(request, RecurrenceScope.OnlyThis, _recurrence))
            : OnSaveEdit.InvokeAsync(request);
    }

    private async Task ConfirmScopeAsync(RecurrenceScope scope)
    {
        var request = _pendingEdit;
        _pendingEdit = null;
        if (request is null) return;
        var edit = new RecurringEdit(request, scope, scope == RecurrenceScope.ThisAndFollowing ? _recurrence : null);
        if (OnSaveRecurring.HasDelegate) await OnSaveRecurring.InvokeAsync(edit);
        else await OnSaveEdit.InvokeAsync(request);
    }

    private EditTaskRequest BuildEdit(TaskWhen when) => new(
        Existing!.Task.Id, _title ?? "", _levelId, _categoryId, _time,
        _time is not null && _reminderMinutes is { } m ? TimeSpan.FromMinutes(m) : null,
        _notes, when, when == TaskWhen.OtherDay ? _date : null, _pinned, _favorite && !Existing.Task.IsFavoriteSource);
}
