@page "/"
@using ThreeMustTasks.Core.Services
@implements IDisposable
@inject IStringLocalizer<Strings> L
@inject TodayService Today
@inject PlanEvents Events

<PageTitle>@L["App_Name"] · @L["Today_Title"]</PageTitle>
<MudText Typo="Typo.h5" Class="tmt-title">@L["Today_Title"]</MudText>

@if (_view is not null)
{
    <MudText Color="Color.Secondary" Class="mb-4" data-testid="today-date">@SpanishDate.Format(_view.Date)</MudText>

    @if (!_view.Quota.IsPlanMinimumMet)
    {
        <div class="tmt-banner" role="status" data-testid="plan-banner">
            <MudIcon Icon="@Icons.Material.Filled.WarningAmber" />
            <span class="tmt-banner-text" data-testid="plan-banner-text">@BannerText(_view.Quota)</span>
            <a class="tmt-banner-action" href="@PlanUrl(_view.Quota)" data-testid="plan-banner-action">@L["Today_BannerAction"]</a>
        </div>
    }

    @if (_view.Groups.All(g => g.Tasks.Count == 0))
    {
        <MudText Color="Color.Secondary" Class="mb-4" data-testid="today-empty">@L["Today_Empty"]</MudText>
    }

    @foreach (var g in _view.Groups)
    {
        var level = g.Level;
        <section class="tmt-group" data-testid="group-@level.Name" style="--level-color:@level.Color">
            <h2 class="tmt-group-header">
                <MudIcon Icon="@LevelIcons.Resolve(level.Icon)" Style="@($"color:{level.Color}")" />
                <span class="tmt-level-name">@level.Name</span>
                <span class="tmt-group-count" data-testid="count-@level.Name">@(g.Slots > 0 ? $"{g.Tasks.Count}/{g.Slots}" : g.Tasks.Count.ToString())</span>
            </h2>
            <div class="tmt-progress" data-testid="progress-@level.Name">
                @if (level.MinToComplete > 0)
                {
                    <span>@L["Today_Progress", g.Completed, level.MinToComplete]</span>
                    @if (g.Completed >= level.MinToComplete)
                    {
                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Title="@L["Today_ProgressDone"]" />
                    }
                }
                else if (g.Tasks.Count > 0)
                {
                    <span>@L["Today_Done", g.Completed, g.Tasks.Count]</span>
                }
                else
                {
                    <span>@L["Today_Optional"]</span>
                }
            </div>

            @if (g.Tasks.Count > 0)
            {
                <ul class="tmt-task-list">
                    @foreach (var t in g.Tasks)
                    {
                        var done = t.Outcome == AssignmentOutcome.Completed;
                        var id = t.AssignmentId;
                        <li class="tmt-task @(done ? "done" : "")" data-testid="task">
                            <button type="button" role="checkbox" aria-checked="@(done ? "true" : "false")"
                                    class="tmt-check" data-testid="toggle"
                                    aria-label="@(done ? L["Today_Uncheck", t.Task.Title] : L["Today_Check", t.Task.Title])"
                                    @onclick="() => ToggleAsync(id, done)">
                                <MudIcon Icon="@(done ? Icons.Material.Filled.CheckCircle : Icons.Material.Outlined.RadioButtonUnchecked)"
                                         Style="@($"color:{level.Color}")" />
                            </button>
                            <a class="tmt-task-title" href="tarea/@t.Task.Id" data-testid="task-title">@t.Task.Title</a>
                            @if (t.PinnedDay is { } day)
                            {
                                <span class="tmt-pinned" data-testid="pinned-badge">
                                    <MudIcon Icon="@Icons.Material.Filled.PushPin" Size="Size.Small" />
                                    @L["Today_PinnedDay", day]
                                </span>
                            }
                            @if (!done)
                            {
                                <button type="button" class="tmt-task-menu-btn" data-testid="task-menu-button"
                                        aria-haspopup="menu" aria-expanded="@(_menuFor == id ? "true" : "false")"
                                        aria-label="@L["Today_TaskMenu", t.Task.Title]"
                                        @onclick="() => _menuFor = _menuFor == id ? null : id">
                                    <MudIcon Icon="@Icons.Material.Filled.MoreVert" />
                                </button>
                            }
                        </li>
                        @if (_menuFor == id && !done)
                        {
                            var pin = !t.Task.IsPinned;
                            var taskId = t.Task.Id;
                            <li class="tmt-task-menu" role="none">
                                <div role="menu" data-testid="task-menu">
                                    <button type="button" role="menuitem" data-testid="@(pin ? "menu-pin" : "menu-unpin")"
                                            @onclick="() => SetPinnedAsync(taskId, pin)">@(pin ? L["Today_Pin"] : L["Today_Unpin"])</button>
                                </div>
                            </li>
                        }
                    }
                </ul>
            }

            @for (var i = 0; i < g.EmptySlots; i++)
            {
                <a class="tmt-slot" href="@NewTaskUrl(level.Id)" data-testid="empty-slot">
                    <MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Small" />
                    <span>@L["Today_EmptySlot", level.Name]</span>
                </a>
            }

            @if (g.EmptySlots == 0 && !g.IsFull)
            {
                <a class="tmt-slot tmt-slot-optional" href="@NewTaskUrl(level.Id)" data-testid="add-optional">
                    <MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Small" />
                    <span>@L["Today_AddOptional", level.Name]</span>
                </a>
            }

            @if (g.IsFull)
            {
                <span class="tmt-full-note" data-testid="full-@level.Name">@L["Today_LevelFull"]</span>
            }
        </section>
    }
}

<MudFab Href="tarea/nueva" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
        Class="tmt-fab" aria-label="@L["Today_AddTask"]" data-testid="fab-add" />

@code {
    private TodayView? _view;
    private Guid? _menuFor;

    private async Task SetPinnedAsync(Guid taskId, bool pinned)
    {
        _menuFor = null;
        await Today.SetPinnedAsync(taskId, pinned);
    }

    protected override async Task OnInitializedAsync()
    {
        Events.PlanChanged += OnPlanChanged;
        _view = await Today.GetAsync();
    }

    private void OnPlanChanged(DateOnly _) => InvokeAsync(async () =>
    {
        _view = await Today.GetAsync();
        StateHasChanged();
    });

    private Task<bool> ToggleAsync(Guid assignmentId, bool isDone) =>
        isDone ? Today.UncompleteAsync(assignmentId) : Today.CompleteAsync(assignmentId);

    private static string NewTaskUrl(Guid levelId) => $"tarea/nueva?nivel={levelId}";

    /// <summary>
    /// Destino del banner: la pantalla Planificar, con el primer nivel al que le falte algo preseleccionado.
    /// </summary>
    internal static string PlanUrl(QuotaStatus quota) =>
        quota.MissingToAdd.Count > 0 ? $"planificar?nivel={quota.MissingToAdd[0].Level.Id}" : "planificar";

    private string BannerText(QuotaStatus quota)
    {
        var parts = quota.MissingToAdd.Select(m => $"{m.Missing} {m.Level.Name}").ToList();
        var list = parts.Count <= 1
            ? string.Join("", parts)
            : string.Join(", ", parts.Take(parts.Count - 1)) + L["Today_And"].Value + parts[^1];
        return L["Today_Banner", list];
    }

    public void Dispose() => Events.PlanChanged -= OnPlanChanged;
}
