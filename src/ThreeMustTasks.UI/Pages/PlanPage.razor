@page "/planificar"
@using ThreeMustTasks.Core.Services
@implements IDisposable
@inject IStringLocalizer<Strings> L
@inject TodayService Today
@inject PlanEvents Events
@inject NavigationManager Nav
@inject ThreeMustTasks.Core.Ports.ISettingsStore Store

<PageTitle>@L["App_Name"] · @L["Plan_Title"]</PageTitle>
@* Hoja inferior (mock Planificar): el fondo se atenúa y la página sube como un panel con asa; no cambia la ruta. *@
<div class="tmt-sheet-ghost" aria-hidden="true"><span></span><span></span></div>
<section class="tmt-sheet" aria-label="@L["Plan_Title"]" data-testid="plan-sheet">
<div class="tmt-sheet-handle" aria-hidden="true"><span></span></div>
<div class="tmt-sheet-head">
    <MudText Typo="Typo.h5" HtmlTag="h1" Class="tmt-title">@L["Plan_Title"]</MudText>
    <a class="tmt-sheet-close" href="" aria-label="@L["Plan_Close"]" data-testid="plan-close">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
    </a>
</div>
<div class="tmt-sheet-body">
@if (_view is not null)
{
    @if (StrictBlocking)
    {
        <MudAlert Severity="Severity.Warning" Class="mb-2" data-testid="plan-strict-notice">@L["Plan_StrictNotice"]</MudAlert>
    }
    @if (_blocked)
    {
        <MudAlert Severity="Severity.Error" Class="mb-2" data-testid="plan-strict-blocked">@L["Plan_StrictBlocked"]</MudAlert>
    }
    <div class="tmt-quota-strip" role="status" aria-label="@L["Plan_Quotas"]" data-testid="plan-quotas">
        @foreach (var g in _view.Groups)
        {
            <span class="tmt-quota @(g.IsFull ? "full" : "")" style="--level-color:@g.Level.Color" data-testid="quota-@g.Level.Name">
                <span class="tmt-quota-name">@g.Level.Name</span> <span class="tmt-quota-count">@g.Tasks.Count<small>/@g.Slots</small></span>
            </span>
        }
    </div>
}

<div class="tmt-segment tmt-plan-tabs" role="tablist" aria-label="@L["Plan_Title"]">
    <button type="button" role="tab" class="tmt-seg" aria-selected="@Sel("nueva")" aria-pressed="@Sel("nueva")" data-testid="tab-nueva"
            @onclick='() => _tab = "nueva"'>@L["Plan_TabNew"]</button>
    <button type="button" role="tab" class="tmt-seg" aria-selected="@Sel("favoritas")" aria-pressed="@Sel("favoritas")" data-testid="tab-favoritas"
            @onclick='() => _tab = "favoritas"'>@L["Plan_TabFavorites"]</button>
    <button type="button" role="tab" class="tmt-seg" aria-selected="@Sel("pool")" aria-pressed="@Sel("pool")" data-testid="tab-pool"
            @onclick='() => _tab = "pool"'>@L["Plan_TabPool"]</button>
</div>

<div role="tabpanel" data-testid="plan-panel">
    @switch (_tab)
    {
        case "favoritas":
            <FavoritesPanel />
            break;
        case "pool":
            <PoolPanel Sheet="true" />
            break;
        default:
            <NewTaskPanel InitialLevelId="LevelId" />
            break;
    }
</div>
</div>
</section>

@code {
    private TodayView? _view;
    private string _tab = "nueva";
    private string? _appliedTab;
    private IDisposable? _lock;
    private bool _blocked;

    [SupplyParameterFromQuery(Name = "nivel")] public Guid? LevelId { get; set; }

    /// <summary>Pestaña inicial: <c>nueva</c> (por defecto), <c>favoritas</c> o <c>pool</c>.</summary>
    [SupplyParameterFromQuery(Name = "pestana")] public string? Tab { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Events.PlanChanged += OnPlanChanged;
        _lock = Nav.RegisterLocationChangingHandler(OnLocationChanging);
        _view = await Today.GetAsync();
    }

    protected override void OnParametersSet()
    {
        if (Tab == _appliedTab) return;
        _appliedTab = Tab;
        if (Tab is "nueva" or "favoritas" or "pool") _tab = Tab;
    }

    private void OnPlanChanged(DateOnly _) => InvokeAsync(async () =>
    {
        _view = await Today.GetAsync();
        if (!StrictBlocking) _blocked = false;
        StateHasChanged();
    });

    private string Sel(string tab) => _tab == tab ? "true" : "false";

    // Modo estricto (PRD §5.2): no se sale de Planificar hasta cumplir el mínimo a añadir. Cambiar de pestaña o de
    // parámetros dentro de la misma página sí se permite.
    private bool StrictBlocking => _view is { Quota.IsPlanMinimumMet: false } && Store.Load().StrictMode;

    private ValueTask OnLocationChanging(LocationChangingContext context)
    {
        if (!StrictBlocking) return ValueTask.CompletedTask;
        var target = Nav.ToAbsoluteUri(context.TargetLocation).AbsolutePath.TrimEnd('/');
        if (target.EndsWith("/planificar", StringComparison.Ordinal)) return ValueTask.CompletedTask;
        context.PreventNavigation();
        _blocked = true;
        InvokeAsync(StateHasChanged);
        return ValueTask.CompletedTask;
    }

    public void Dispose()
    {
        Events.PlanChanged -= OnPlanChanged;
        _lock?.Dispose();
    }
}
