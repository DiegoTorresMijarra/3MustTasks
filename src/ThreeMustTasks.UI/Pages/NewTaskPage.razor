@inject NavigationManager Navigation

<PageTitle>@L["App_Name"] · @L["Form_NewTitle"]</PageTitle>

<NewTaskPanel InitialLevelId="LevelId" Title="@L["Form_NewTitle"]" OnDone="GoBack" />

