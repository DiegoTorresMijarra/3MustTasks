@page "/tarea/nueva"
@inject IStringLocalizer<Strings> L
@inject NavigationManager Navigation

<PageTitle>@L["App_Name"] · @L["Form_NewTitle"]</PageTitle>
<MudText Typo="Typo.h5" Class="mb-4 tmt-title">@L["Form_NewTitle"]</MudText>

<NewTaskPanel InitialLevelId="LevelId" OnDone="GoBack" />

@code {
    [SupplyParameterFromQuery(Name = "nivel")] public Guid? LevelId { get; set; }

    private void GoBack() => Navigation.NavigateTo("");
}
