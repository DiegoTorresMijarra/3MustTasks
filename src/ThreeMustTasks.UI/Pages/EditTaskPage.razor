@page "/tarea/{TaskId:guid}"
@using ThreeMustTasks.Core.Services
@inject IStringLocalizer<Strings> L
@inject TodayService Today
@inject TaskEditService Editor
@inject CategoryService Categories
@inject FavoriteService Favorites
@inject RecurrenceService Recurrences
@inject NavigationManager Navigation

<PageTitle>@L["App_Name"] · @L["Form_EditTitle"]</PageTitle>
@if (_task is not { ReadOnly: false })
{
    <MudText Typo="Typo.h5" HtmlTag="h1" Class="mb-4 tmt-title">@L["Form_EditTitle"]</MudText>
}

@if (_loaded && _task is null)
{
    <MudText Color="Color.Secondary" data-testid="task-missing">@L["Form_NotFound"]</MudText>
    <MudButton Variant="Variant.Text" OnClick="GoBack">@L["Form_Back"]</MudButton>
}
else if (_task is { ReadOnly: true })
{
    <div class="tmt-readonly" data-testid="task-readonly">
        <MudAlert Severity="Severity.Info" Class="mb-3">@L["Form_ReadOnly"]</MudAlert>
        <MudText Typo="Typo.subtitle1" data-testid="readonly-title">@_task.Task.Title</MudText>
        @if (!string.IsNullOrWhiteSpace(_task.Task.Notes))
        {
            <MudText Color="Color.Secondary">@_task.Task.Notes</MudText>
        }
        <MudButton Variant="Variant.Text" OnClick="GoBack" Class="mt-3">@L["Form_Back"]</MudButton>
    </div>
}
else if (_task is not null && _view is not null)
{
    <TaskForm Title="@L["Form_EditTitle"]" Groups="_view.Groups" Existing="_task" Categories="_categories" TodayDate="_view.Date"
              FullLevelId="_fullLevelId" Error="@_error" Rule="_rule"
              OnSaveEdit="SaveAsync" OnSaveRecurring="SaveRecurringAsync" OnDelete="DeleteAsync" OnCancel="GoBack" />
}

@code {
    private TodayView? _view;
    private EditableTask? _task;
    private RecurrenceRule? _rule;
    private IReadOnlyList<Category> _categories = [];
    private Guid? _fullLevelId;
    private string? _error;
    private bool _loaded;

    [Parameter] public Guid TaskId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _view = await Today.GetAsync();
        _categories = await Categories.ListAsync();
        _task = await Editor.GetAsync(TaskId);
        if (_task?.Task.RecurrenceRuleId is { } ruleId) _rule = await Recurrences.GetAsync(ruleId);
        _loaded = true;
    }

    private async Task SaveAsync(EditTaskRequest request)
    {
        _fullLevelId = null;
        _error = null;
        await ApplyEditAsync(request, await Editor.UpdateAsync(request));
    }

    private async Task SaveRecurringAsync(RecurringEdit edit)
    {
        _fullLevelId = null;
        _error = null;
        var result = await Recurrences.UpdateTaskAsync(edit.Request, edit.Scope, edit.Spec);
        if (result.Edit is null) _error = RecurrenceText.Error(L, result.Recurrence);
        else if (!result.Edit.Succeeded) await ApplyEditAsync(edit.Request, result.Edit);
        else if (result.Recurrence != RecurrenceOutcome.Saved) _error = RecurrenceText.Error(L, result.Recurrence);
        else
        {
            if (edit.Request.MarkFavorite) await Favorites.MarkAsync(edit.Request.TaskId);
            GoBack();
        }
    }

    private async Task ApplyEditAsync(EditTaskRequest request, EditTaskResult result)
    {
        switch (result.Outcome)
        {
            case EditTaskOutcome.Saved:
                if (request.MarkFavorite) await Favorites.MarkAsync(request.TaskId);
                GoBack();
                break;
            case EditTaskOutcome.LevelFull: _fullLevelId = request.LevelId; break;
            default: _error = ErrorText(result.Outcome); break;
        }
    }

    private async Task DeleteAsync()
    {
        if (await Editor.DeleteAsync(TaskId)) GoBack();
    }

    private string ErrorText(EditTaskOutcome outcome) => outcome switch
    {
        EditTaskOutcome.InvalidTitle => L["Err_InvalidTitle"],
        EditTaskOutcome.TitleTooLong => L["Err_TitleTooLong", TaskEditService.MaxTitleLength],
        EditTaskOutcome.NotesTooLong => L["Err_NotesTooLong", TaskEditService.MaxNotesLength],
        EditTaskOutcome.ReminderWithoutTime => L["Err_ReminderWithoutTime"],
        EditTaskOutcome.InvalidDate => L["Err_InvalidDate"],
        EditTaskOutcome.CannotMoveCompleted => L["Err_CannotMoveCompleted"],
        EditTaskOutcome.ReadOnly => L["Form_ReadOnly"],
        _ => L["Err_Generic"],
    };

    private void GoBack() => Navigation.NavigateTo("");
}
