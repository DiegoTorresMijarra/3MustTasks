@page "/ajustes"
@using ThreeMustTasks.Core.Ports
@using ThreeMustTasks.Core.Services
@implements IDisposable
@inject IStringLocalizer<Strings> L
@inject ThemeService Theme
@inject ISettingsStore Store
@inject INotificationScheduler Scheduler
@inject INotificationPermission Permission
@inject ThreeMustTasks.Core.Services.ReminderSyncService Reminders
@inject LevelService LevelSvc

<PageTitle>@L["App_Name"] · @L["Settings_Title"]</PageTitle>
<MudText Typo="Typo.h5" HtmlTag="h1" Class="mb-4 tmt-title">@L["Settings_Title"]</MudText>

@* Niveles y mínimos diarios (mock Ajustes): tarjetas con contadores; la gestión completa (orden, color, icono, borrar) vive en Niveles y cupos. *@
<section class="tmt-levels-section" data-testid="levels-section">
    <div class="tmt-section-row">
        <h2 class="tmt-section-label">@L["Levels_Section"]</h2>
        <span class="tmt-section-aside" data-testid="levels-total">@L["Levels_Total", _levels.Where(l => l.Enabled).Sum(l => l.MinToAdd)]</span>
    </div>
    @foreach (var lvl in _levels)
    {
        <LevelCard Level="lvl" OnChanged="LoadLevelsAsync">
            <Head>
                <a class="tmt-icon-btn" href="ajustes/niveles" aria-label="@L["Levels_Edit", lvl.Name]">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 20h4l10.5-10.5a2.1 2.1 0 0 0-3-3L5 17v3z"/></svg>
                </a>
            </Head>
        </LevelCard>
    }
    <div class="tmt-levels-actions">
        <a class="tmt-dashed-btn" href="ajustes/niveles" data-testid="levels-add">@L["Levels_AddLevel"]</a>
        @if (!_confirmingRestore)
        {
            <button type="button" class="tmt-link-btn" @onclick="() => _confirmingRestore = true" data-testid="levels-restore-defaults">@L["Levels_Restore"]</button>
        }
    </div>
    @if (_confirmingRestore)
    {
        <MudAlert Severity="Severity.Warning" Class="mt-2" data-testid="levels-restore-confirm">
            @L["Levels_RestoreConfirm"]
            <div class="mt-2 tmt-confirm-actions">
                <MudButton Variant="Variant.Filled" Color="Color.Warning" OnClick="RestoreLevelsAsync" data-testid="levels-restore-yes">@L["Levels_RestoreYes"]</MudButton>
                <MudButton Variant="Variant.Text" OnClick="() => _confirmingRestore = false" data-testid="levels-restore-no">@L["Form_Cancel"]</MudButton>
            </div>
        </MudAlert>
    }
</section>

<MudText Typo="Typo.h6" Class="mt-6 mb-2">@L["Settings_Appearance"]</MudText>
<MudRadioGroup T="ThemeMode" Value="Theme.Mode" ValueChanged="Theme.SetMode" aria-label="@L["Settings_Theme"]">
    <MudRadio T="ThemeMode" Value="ThemeMode.System" Color="Color.Primary" data-testid="theme-system">@L["Theme_System"]</MudRadio>
    <MudRadio T="ThemeMode" Value="ThemeMode.Light" Color="Color.Primary" data-testid="theme-light">@L["Theme_Light"]</MudRadio>
    <MudRadio T="ThemeMode" Value="ThemeMode.Dark" Color="Color.Primary" data-testid="theme-dark">@L["Theme_Dark"]</MudRadio>
</MudRadioGroup>

<MudText Typo="Typo.h6" Class="mt-6 mb-2">@L["Settings_General"]</MudText>
<div class="tmt-form tmt-card">
    <label class="tmt-field">
        <span>@L["Settings_DayStart"]</span>
        <input type="time" value="@_dayStart" @onchange="OnDayStart" data-testid="setting-daystart" />
        <span class="tmt-level-hint">@L["Settings_DayStartHint"]</span>
    </label>
    <label class="tmt-field">
        <span>@L["Settings_FirstDay"]</span>
        <select value="@((int)_s.FirstDayOfWeek)" @onchange="OnFirstDay" data-testid="setting-firstday">
            @foreach (var d in _weekDays)
            {
                <option value="@((int)d)">@L[$"Day_{d}"]</option>
            }
        </select>
    </label>
    <label class="tmt-field tmt-check-row">
        <span>@L["Settings_Strict"]</span>
        <input type="checkbox" checked="@_s.StrictMode" @onchange="e => Update(s => s with { StrictMode = (bool)e.Value! })" data-testid="setting-strict" />
    </label>
    <label class="tmt-field tmt-check-row">
        <span>@L["Settings_AutoAdd"]</span>
        <input type="checkbox" checked="@_s.AutoAddScheduled" @onchange="e => Update(s => s with { AutoAddScheduled = (bool)e.Value! })" data-testid="setting-autoadd" />
    </label>
    <label class="tmt-field tmt-check-row">
        <span>@L["Settings_VTodo"]</span>
        <input type="checkbox" checked="@_s.ExportVTodo" @onchange="e => Update(s => s with { ExportVTodo = (bool)e.Value! })" data-testid="setting-vtodo" />
    </label>
</div>

<MudText Typo="Typo.h6" Class="mt-6 mb-2">@L["Settings_Notifications"]</MudText>
<div class="tmt-form tmt-card" data-testid="notif-settings">
    <label class="tmt-field tmt-check-row">
        <span>@L["Settings_PlanReminder"]</span>
        <input type="checkbox" checked="@_s.PlanReminderEnabled" @onchange="e => Update(s => s with { PlanReminderEnabled = (bool)e.Value! })" data-testid="setting-planreminder" />
    </label>
    <label class="tmt-field">
        <span>@L["Settings_PlanReminderTime"]</span>
        <input type="time" value="@_planTime" @onchange="OnPlanTime" disabled="@(!_s.PlanReminderEnabled)" data-testid="setting-planreminder-time" />
    </label>
    <fieldset class="tmt-field" disabled="@(!_s.PlanReminderEnabled)">
        <span>@L["Settings_PlanReminderDays"]</span>
        <div class="tmt-chips">
            @foreach (var d in _weekDays)
            {
                var day = d;
                <label class="tmt-chip">
                    <input type="checkbox" checked="@_s.PlanReminderOnDay(day)" @onchange="e => Update(s => s.WithPlanReminderDay(day, (bool)e.Value!))" data-testid="@($"setting-planreminder-day-{(int)day}")" />
                    @L[$"Day_{day}"]
                </label>
            }
        </div>
    </fieldset>

    <label class="tmt-field tmt-check-row">
        <span>@L["Settings_Nag"]</span>
        <input type="checkbox" checked="@_s.NagEnabled" @onchange="e => Update(s => s with { NagEnabled = (bool)e.Value! })" data-testid="setting-nag" />
    </label>
    <label class="tmt-field">
        <span>@L["Settings_NagInterval"]</span>
        <input type="number" min="5" max="240" step="5" value="@_s.NagIntervalMin" disabled="@(!_s.NagEnabled)"
               @onchange="e => OnNumber(e, 5, 240, (s, n) => s with { NagIntervalMin = n })" data-testid="setting-nag-interval" />
    </label>
    <label class="tmt-field">
        <span>@L["Settings_NagMax"]</span>
        <input type="number" min="1" max="@ReminderPlanner.MaxNagsPerDay" value="@_s.NagMaxPerDay" disabled="@(!_s.NagEnabled)"
               @onchange="e => OnNumber(e, 1, ReminderPlanner.MaxNagsPerDay, (s, n) => s with { NagMaxPerDay = n })" data-testid="setting-nag-max" />
    </label>
    <label class="tmt-field tmt-check-row">
        <span>@L["Settings_CompletionReminder"]</span>
        <input type="checkbox" checked="@_s.CompletionReminderEnabled" @onchange="e => Update(s => s with { CompletionReminderEnabled = (bool)e.Value! })" data-testid="setting-completion" />
    </label>
    <label class="tmt-field">
        <span>@L["Settings_CompletionTime"]</span>
        <input type="time" value="@_completionTime" @onchange="OnCompletionTime" disabled="@(!_s.CompletionReminderEnabled)" data-testid="setting-completion-time" />
    </label>

    @* Issue 20: recordatorio de tarea con hora, resumen nocturno y tareas a futuro. *@
    <label class="tmt-field">
        <span>@L["Settings_DefaultReminder"]</span>
        <select value="@_s.DefaultReminderOffsetMin" @onchange="e => OnNumber(e, 0, 60, (s, n) => s with { DefaultReminderOffsetMin = n })" data-testid="setting-default-reminder">
            @foreach (var m in _reminderOffsets)
            {
                <option value="@m" selected="@(m == _s.DefaultReminderOffsetMin)">@(m == 0 ? L["Form_ReminderAtTime"].Value : L["Form_ReminderBefore", m].Value)</option>
            }
        </select>
    </label>
    <label class="tmt-field tmt-check-row">
        <span>@L["Settings_EveningSummary"]</span>
        <input type="checkbox" checked="@_s.EveningSummaryEnabled" @onchange="e => Update(s => s with { EveningSummaryEnabled = (bool)e.Value! })" data-testid="setting-summary" />
    </label>
    <label class="tmt-field">
        <span>@L["Settings_EveningSummaryTime"]</span>
        <input type="time" value="@_s.EveningSummaryTime.ToString("HH:mm")" @onchange="OnSummaryTime" disabled="@(!_s.EveningSummaryEnabled)" data-testid="setting-summary-time" />
    </label>
    <label class="tmt-field tmt-check-row">
        <span>@L["Settings_FutureAlert"]</span>
        <input type="checkbox" checked="@_s.FutureTaskAlertEnabled" @onchange="e => Update(s => s with { FutureTaskAlertEnabled = (bool)e.Value! })" data-testid="setting-future-alert" />
    </label>

    @if (Permission.OnlyWorksWhileOpen)
    {
        <MudAlert Severity="Severity.Warning" Class="mt-2" data-testid="settings-pwa-warning">@L["Onb_PwaWarning"]</MudAlert>
    }

    @if (_status is { Supported: true })
    {
        <div class="tmt-onb-note" data-testid="notif-status">
            @if (_status.NotificationsEnabled)
            {
                <span data-testid="notif-permission-granted">@L["Notif_PermGranted"]</span>
            }
            else
            {
                <span data-testid="notif-permission-missing">@L["Notif_PermMissing"]</span>
                <div>
                    <button type="button" class="tmt-onb-secondary" @onclick="RequestPermissionAsync" data-testid="notif-request-permission">@L["Notif_RequestPermission"]</button>
                    @if (!Permission.OnlyWorksWhileOpen)
                    {
                        <button type="button" class="tmt-onb-secondary" @onclick="() => OpenAsync(SystemSettingsTarget.Notifications)" data-testid="notif-open-settings">@L["Notif_OpenSettings"]</button>
                    }
                </div>
            }
        </div>
        @if (!_status.ExactAlarmsAllowed)
        {
            <div class="tmt-onb-note" data-testid="notif-inexact">
                <span>@L["Notif_Inexact"]</span>
                <div>
                    <button type="button" class="tmt-onb-secondary" @onclick="() => OpenAsync(SystemSettingsTarget.ExactAlarms)" data-testid="notif-open-exact">@L["Notif_OpenExact"]</button>
                </div>
            </div>
        }
        @if (!Permission.OnlyWorksWhileOpen)
        {
            <a class="tmt-settings-link" href="ajustes/bateria" data-testid="battery-link">@L["Notif_BatteryLink"]</a>
        }
    }
    else if (_status is not null)
    {
        <div class="tmt-onb-note" data-testid="notif-unsupported">@L["Notif_Unsupported"]</div>
    }
</div>

<MudText Typo="Typo.h6" Class="mt-6 mb-2">@L["Settings_Organization"]</MudText>
<div class="tmt-card tmt-link-card">
    <a class="tmt-settings-link" href="ajustes/niveles" data-testid="levels-link">@L["Settings_Levels"]</a>
    <a class="tmt-settings-link" href="ajustes/categorias" data-testid="categories-link">@L["Categories_Title"]</a>
    <a class="tmt-settings-link" href="ajustes/recurrentes" data-testid="recurrences-link">@L["Rec_Title"]</a>
    <a class="tmt-settings-link" href="onboarding" data-testid="onboarding-link">@L["Settings_Onboarding"]</a>
</div>

<IcsExportPanel />

<IcsImportPanel />

<BackupPanel OnRestored="ReloadSettings" />

@code {
    private async Task ReloadSettings()
    {
        _s = Store.Load();
        _dayStart = _s.DayStartsAt.ToString("HH:mm");
        _planTime = _s.PlanningReminderTime.ToString("HH:mm");
        _completionTime = _s.CompletionReminderTime.ToString("HH:mm");
        // Tras restaurar un backup los ajustes y el plan han cambiado: se reprograman los avisos.
        await Reminders.RebuildAsync();
        _status = await Scheduler.GetStatusAsync();
    }

    private NotificationStatus? _status;
    private string _planTime = "07:30";

    private IReadOnlyList<ThreeMustTasks.Core.Domain.Level> _levels = [];

    private async Task LoadLevelsAsync() => _levels = await LevelSvc.ListAsync();

    private bool _confirmingRestore;

    private async Task RestoreLevelsAsync()
    {
        _confirmingRestore = false;
        await LevelSvc.RestoreDefaultsAsync();
        await LoadLevelsAsync();
    }

    protected override async Task OnInitializedAsync()
    {
        _status = await Scheduler.GetStatusAsync();
        await LoadLevelsAsync();
    }

    private async Task RequestPermissionAsync()
    {
        await Scheduler.RequestPermissionAsync();
        await Reminders.RebuildAsync();
        _status = await Scheduler.GetStatusAsync();
    }

    private async Task OpenAsync(SystemSettingsTarget target) => await Scheduler.OpenSystemSettingsAsync(target);

    private string _completionTime = "18:00";

    // Fuera de rango o no numérico: se ignora y se conserva el valor anterior.
    private void OnNumber(ChangeEventArgs e, int min, int max, Func<AppSettings, int, AppSettings> apply)
    {
        if (int.TryParse(e.Value?.ToString(), out var n) && n >= min && n <= max) Update(s => apply(s, n));
    }

    private void OnCompletionTime(ChangeEventArgs e)
    {
        if (!TimeOnly.TryParseExact(e.Value?.ToString(), "HH:mm", out var time)) return;
        _completionTime = e.Value!.ToString()!;
        Update(s => s with { CompletionReminderTime = time });
    }

    private void OnPlanTime(ChangeEventArgs e)
    {
        if (!TimeOnly.TryParseExact(e.Value?.ToString(), "HH:mm", out var time)) return;
        _planTime = e.Value!.ToString()!;
        Update(s => s with { PlanningReminderTime = time });
    }

    private static readonly DayOfWeek[] _weekDays =
        [DayOfWeek.Monday, DayOfWeek.Tuesday, DayOfWeek.Wednesday, DayOfWeek.Thursday, DayOfWeek.Friday, DayOfWeek.Saturday, DayOfWeek.Sunday];

    private AppSettings _s = new();
    private string _dayStart = "00:00";

    protected override void OnInitialized()
    {
        Theme.OnChange += OnChanged;
        _s = Store.Load();
        _dayStart = _s.DayStartsAt.ToString("HH:mm");
        _planTime = _s.PlanningReminderTime.ToString("HH:mm");
        _completionTime = _s.CompletionReminderTime.ToString("HH:mm");
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => Theme.OnChange -= OnChanged;

    private void Update(Func<AppSettings, AppSettings> change)
    {
        // Se relee antes de guardar para no pisar otros cambios (p. ej. el tema).
        _s = change(Store.Load());
        Store.Save(_s);
        // Hora, días, activación o inicio del día lógico cambian lo que debe estar programado.
        _ = Reminders.RebuildAsync();
    }

    private void OnDayStart(ChangeEventArgs e)
    {
        // Un valor vacío o inválido se ignora y se conserva el anterior.
        if (!TimeOnly.TryParseExact(e.Value?.ToString(), "HH:mm", out var time)) return;
        _dayStart = e.Value!.ToString()!;
        Update(s => s with { DayStartsAt = time });
    }

    private void OnFirstDay(ChangeEventArgs e) =>
        Update(s => s with { FirstDayOfWeek = (DayOfWeek)int.Parse(e.Value!.ToString()!) });
}

@code {
    // Issue 20: recordatorio por defecto de tareas con hora, resumen nocturno y tareas a futuro.
    private static readonly int[] _reminderOffsets = [0, 5, 15, 30, 60];

    private void OnSummaryTime(ChangeEventArgs e)
    {
        if (!TimeOnly.TryParseExact(e.Value?.ToString(), "HH:mm", out var time)) return;
        Update(s => s with { EveningSummaryTime = time });
    }
}
