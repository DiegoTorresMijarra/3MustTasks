<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
  </PropertyGroup>

  <!-- Tamaño y arranque (issue 28, spec §8): trimming y Brotli explícitos en el publish. Son los valores por defecto del SDK
       para Blazor WASM; se dejan escritos para que un cambio accidental salte en revisión. TrimMode partial (por defecto)
       porque el trimming "full" rompe la reflexión de Microsoft.Extensions.Localization y System.Text.Json. -->
  <PropertyGroup>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <BlazorEnableCompression>true</BlazorEnableCompression>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.13" PrivateAssets="all" />
    <PackageReference Include="MudBlazor" Version="9.11.0" />
  </ItemGroup>

  <ItemGroup>
    <ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ThreeMustTasks.UI\ThreeMustTasks.UI.csproj" />
    <ProjectReference Include="..\ThreeMustTasks.Core\ThreeMustTasks.Core.csproj" />
    <ProjectReference Include="..\ThreeMustTasks.Infrastructure.Browser\ThreeMustTasks.Infrastructure.Browser.csproj" />
    <ProjectReference Include="..\ThreeMustTasks.Infrastructure.Shared\ThreeMustTasks.Infrastructure.Shared.csproj" />
  </ItemGroup>

</Project>
